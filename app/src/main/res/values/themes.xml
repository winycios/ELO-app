<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema base (assumido após a splash). O visual real vem do Compose (EloTheme). -->
    <style name="Theme.Elo" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/elo_fundo</item>
    </style>

    <!-- Tema de abertura: splash com a tinta escura da marca e os anéis do logo. -->
    <style name="Theme.Elo.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/elo_tinta_escura</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Elo</item>
    </style>
</resources>